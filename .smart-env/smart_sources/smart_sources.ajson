"smart_sources:My_Document/Personal doc/قانون کار.md": {"class_name":"SmartSource","last_read":{"hash":"yn5dkf","at":1793411154263},"embedding":{"history":[]},"path":"My_Document/Personal doc/قانون کار.md","last_import":{"mtime":1793009609972,"size":3969,"at":1793411154263,"hash":"yn5dkf"},"outlinks":[],"blocks_data":{"#":{"text":null,"length":0,"last_read":{"hash":"241ix6","at":1793411154263},"key":"My_Document/Personal doc/قانون کار.md#","lines":[3,64],"size":2458,"should_embed":true}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"My_Document/Personal doc/قانون کار.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Project/Ai/Animation/Woody_Lab/پرامپت ساخت انیمیشن.md": {"class_name":"SmartSource","last_read":{"hash":"10kl9yf","at":1793411154264},"embedding":{"history":[]},"path":"Project/Ai/Animation/Woody_Lab/پرامپت ساخت انیمیشن.md","last_import":{"mtime":1793017140803,"size":20502,"at":1793411154265,"hash":"10kl9yf"},"outlinks":[],"blocks_data":{"#":{"text":null,"length":0,"last_read":{"hash":"echw72","at":1793411154264},"key":"Project/Ai/Animation/Woody_Lab/پرامپت ساخت انیمیشن.md#","lines":[2,108],"size":9251,"should_embed":true},"####5-@@میخوام طبق تصویری که برات فرستادم، همین محیط و همین موقعیت دوربین و همین حالت ماشین آتش نشانی و مدل و جزئیات آن باشد دقیقا طبق عکسی که فرستادم با همین جزئیات باشد. ادامه ویدئو را بسازیم هدف اینه که این تصویر در همین محیط و همین صحنه و زاویه دوربین و همین مدل آتش نشانی و همین رنگ، به واقعیت تبدیل شود.میخوام در چهار شات این صحنه هایی که میگم را درست کنی. شات اول: ماشین روشن شود آژیر ماشین آتش نشانی بزند و به سمت بیرون از کادر حرکت کند و ادامه محیط نجاری تبدیل به جاده شود (آسمان شب باشد پس هوا تاریک است و در جاده تعدادی ماشین سواری وجود داشته باشد و ماشین آتش نشانی با سرعت بین آنان حرکت می کند چون حادثه آتش سوزی رخ داده و باید خود را به محل آتش سوزی برساند. شات دوم: ماشین آتش نشانی به محل حادثه میرسد (در اینجا ساختمان بلندی را باید نشان دهد که آتش گرفته است و ماشین آتش نشانی توقف کرده و نیروه های آتش نشانی از ماشین پیاده شده (هم زن هستند و هم مرد (با لباس مخصوص آتش نشانی) با عجله و سرعت وارد ساختمان می شوند که آتش گرفته و ساختمان آتش گرفته (بسیار واقعی و طبیعی در آتش دارد میسوزد مثلا شیشه پنجره ها سوخته و آتش از داخل فوران می کند بصورت طبیعی) باید بسیار نمای واقعی داشته باشد) شات سوم: طبق عکس دختر خانم آتش نشان که فرستادم، میخوام داخل ساختمان یک درب چوبی را با ضربه پا بشکند تا بتواند وارد اتاق شود محیط اطراف شامل دود سیاه و آتش سوزی های چوب و تخت و مبل و... است بسیار واقعی و این صحنه باید جوری باشد که دختر خانم آتش نشان، با نگرانی و عجله انگار دنبال کسی میگردد و به اطراف (سمت چپ و راست نگاه می کند) و بچه ای را می بیند که یک جا روی زمین نشسته و دارد گریه میکند. شات چهارم: دختر خانم آتش نشان بچه را بغل کرده (حمل میکند) و با سرعت از ساختمانی که در حال فروپاشی و آتش گرفتن هست خارج می شود و از آن ساختمان جهنمی با آن بچه ای که گریه میکرد خارج میشود و جان بچه را نجات میدهد می خواهم شات سوم و چهارم بصورت جسورانه و هیجانی و سینمایی ساخته شود. دقت کن کل صحنه باید واقعی و سینماتیک و هیجانی باشد پرامپت انگلیسی هر شات را شیک و تمیز برام بفرست فقط پراپت انگلیسی تمیز بهم بده":{"text":null,"length":0,"last_read":{"hash":"1ky9cfm","at":1793411154264},"key":"Project/Ai/Animation/Woody_Lab/پرامپت ساخت انیمیشن.md####5-@@میخوام طبق تصویری که برات فرستادم، همین محیط و همین موقعیت دوربین و همین حالت ماشین آتش نشانی و مدل و جزئیات آن باشد دقیقا طبق عکسی که فرستادم با همین جزئیات باشد. ادامه ویدئو را بسازیم هدف اینه که این تصویر در همین محیط و همین صحنه و زاویه دوربین و همین مدل آتش نشانی و همین رنگ، به واقعیت تبدیل شود.میخوام در چهار شات این صحنه هایی که میگم را درست کنی. شات اول: ماشین روشن شود آژیر ماشین آتش نشانی بزند و به سمت بیرون از کادر حرکت کند و ادامه محیط نجاری تبدیل به جاده شود (آسمان شب باشد پس هوا تاریک است و در جاده تعدادی ماشین سواری وجود داشته باشد و ماشین آتش نشانی با سرعت بین آنان حرکت می کند چون حادثه آتش سوزی رخ داده و باید خود را به محل آتش سوزی برساند. شات دوم: ماشین آتش نشانی به محل حادثه میرسد (در اینجا ساختمان بلندی را باید نشان دهد که آتش گرفته است و ماشین آتش نشانی توقف کرده و نیروه های آتش نشانی از ماشین پیاده شده (هم زن هستند و هم مرد (با لباس مخصوص آتش نشانی) با عجله و سرعت وارد ساختمان می شوند که آتش گرفته و ساختمان آتش گرفته (بسیار واقعی و طبیعی در آتش دارد میسوزد مثلا شیشه پنجره ها سوخته و آتش از داخل فوران می کند بصورت طبیعی) باید بسیار نمای واقعی داشته باشد) شات سوم: طبق عکس دختر خانم آتش نشان که فرستادم، میخوام داخل ساختمان یک درب چوبی را با ضربه پا بشکند تا بتواند وارد اتاق شود محیط اطراف شامل دود سیاه و آتش سوزی های چوب و تخت و مبل و... است بسیار واقعی و این صحنه باید جوری باشد که دختر خانم آتش نشان، با نگرانی و عجله انگار دنبال کسی میگردد و به اطراف (سمت چپ و راست نگاه می کند) و بچه ای را می بیند که یک جا روی زمین نشسته و دارد گریه میکند. شات چهارم: دختر خانم آتش نشان بچه را بغل کرده (حمل میکند) و با سرعت از ساختمانی که در حال فروپاشی و آتش گرفتن هست خارج می شود و از آن ساختمان جهنمی با آن بچه ای که گریه میکرد خارج میشود و جان بچه را نجات میدهد می خواهم شات سوم و چهارم بصورت جسورانه و هیجانی و سینمایی ساخته شود. دقت کن کل صحنه باید واقعی و سینماتیک و هیجانی باشد پرامپت انگلیسی هر شات را شیک و تمیز برام بفرست فقط پراپت انگلیسی تمیز بهم بده","lines":[109,113],"size":2657,"should_embed":false},"####5-@@میخوام طبق تصویری که برات فرستادم، همین محیط و همین موقعیت دوربین و همین حالت ماشین آتش نشانی و مدل و جزئیات آن باشد دقیقا طبق عکسی که فرستادم با همین جزئیات باشد. ادامه ویدئو را بسازیم هدف اینه که این تصویر در همین محیط و همین صحنه و زاویه دوربین و همین مدل آتش نشانی و همین رنگ، به واقعیت تبدیل شود.میخوام در چهار شات این صحنه هایی که میگم را درست کنی. شات اول: ماشین روشن شود آژیر ماشین آتش نشانی بزند و به سمت بیرون از کادر حرکت کند و ادامه محیط نجاری تبدیل به جاده شود (آسمان شب باشد پس هوا تاریک است و در جاده تعدادی ماشین سواری وجود داشته باشد و ماشین آتش نشانی با سرعت بین آنان حرکت می کند چون حادثه آتش سوزی رخ داده و باید خود را به محل آتش سوزی برساند. شات دوم: ماشین آتش نشانی به محل حادثه میرسد (در اینجا ساختمان بلندی را باید نشان دهد که آتش گرفته است و ماشین آتش نشانی توقف کرده و نیروه های آتش نشانی از ماشین پیاده شده (هم زن هستند و هم مرد (با لباس مخصوص آتش نشانی) با عجله و سرعت وارد ساختمان می شوند که آتش گرفته و ساختمان آتش گرفته (بسیار واقعی و طبیعی در آتش دارد میسوزد مثلا شیشه پنجره ها سوخته و آتش از داخل فوران می کند بصورت طبیعی) باید بسیار نمای واقعی داشته باشد) شات سوم: طبق عکس دختر خانم آتش نشان که فرستادم، میخوام داخل ساختمان یک درب چوبی را با ضربه پا بشکند تا بتواند وارد اتاق شود محیط اطراف شامل دود سیاه و آتش سوزی های چوب و تخت و مبل و... است بسیار واقعی و این صحنه باید جوری باشد که دختر خانم آتش نشان، با نگرانی و عجله انگار دنبال کسی میگردد و به اطراف (سمت چپ و راست نگاه می کند) و بچه ای را می بیند که یک جا روی زمین نشسته و دارد گریه میکند. شات چهارم: دختر خانم آتش نشان بچه را بغل کرده (حمل میکند) و با سرعت از ساختمانی که در حال فروپاشی و آتش گرفتن هست خارج می شود و از آن ساختمان جهنمی با آن بچه ای که گریه میکرد خارج میشود و جان بچه را نجات میدهد می خواهم شات سوم و چهارم بصورت جسورانه و هیجانی و سینمایی ساخته شود. دقت کن کل صحنه باید واقعی و سینماتیک و هیجانی باشد پرامپت انگلیسی هر شات را شیک و تمیز برام بفرست فقط پراپت انگلیسی تمیز بهم بده#{1}":{"text":null,"length":0,"last_read":{"hash":"vee1ss","at":1793411154264},"key":"Project/Ai/Animation/Woody_Lab/پرامپت ساخت انیمیشن.md####5-@@میخوام طبق تصویری که برات فرستادم، همین محیط و همین موقعیت دوربین و همین حالت ماشین آتش نشانی و مدل و جزئیات آن باشد دقیقا طبق عکسی که فرستادم با همین جزئیات باشد. ادامه ویدئو را بسازیم هدف اینه که این تصویر در همین محیط و همین صحنه و زاویه دوربین و همین مدل آتش نشانی و همین رنگ، به واقعیت تبدیل شود.میخوام در چهار شات این صحنه هایی که میگم را درست کنی. شات اول: ماشین روشن شود آژیر ماشین آتش نشانی بزند و به سمت بیرون از کادر حرکت کند و ادامه محیط نجاری تبدیل به جاده شود (آسمان شب باشد پس هوا تاریک است و در جاده تعدادی ماشین سواری وجود داشته باشد و ماشین آتش نشانی با سرعت بین آنان حرکت می کند چون حادثه آتش سوزی رخ داده و باید خود را به محل آتش سوزی برساند. شات دوم: ماشین آتش نشانی به محل حادثه میرسد (در اینجا ساختمان بلندی را باید نشان دهد که آتش گرفته است و ماشین آتش نشانی توقف کرده و نیروه های آتش نشانی از ماشین پیاده شده (هم زن هستند و هم مرد (با لباس مخصوص آتش نشانی) با عجله و سرعت وارد ساختمان می شوند که آتش گرفته و ساختمان آتش گرفته (بسیار واقعی و طبیعی در آتش دارد میسوزد مثلا شیشه پنجره ها سوخته و آتش از داخل فوران می کند بصورت طبیعی) باید بسیار نمای واقعی داشته باشد) شات سوم: طبق عکس دختر خانم آتش نشان که فرستادم، میخوام داخل ساختمان یک درب چوبی را با ضربه پا بشکند تا بتواند وارد اتاق شود محیط اطراف شامل دود سیاه و آتش سوزی های چوب و تخت و مبل و... است بسیار واقعی و این صحنه باید جوری باشد که دختر خانم آتش نشان، با نگرانی و عجله انگار دنبال کسی میگردد و به اطراف (سمت چپ و راست نگاه می کند) و بچه ا